# Copy to .env and fill in.

# Postgres in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/docparser
# Defaults to a local SQLite file if unset - fine for local dev/demo.
DATABASE_URL=sqlite:///./docparser.db

UPLOAD_DIR=./uploads

# Provider: "anthropic" (default, cloud) or "ollama" (local, free, offline)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key-here
EXTRACTION_MODEL=claude-sonnet-4-6

# Only used when LLM_PROVIDER=ollama. Model must support vision + structured output
# (e.g. llama3.2-vision, qwen2.5vl, minicpm-v). Run `ollama serve` before starting the app.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_MAX_PAGES=5
OLLAMA_TIMEOUT_SECONDS=120

# --- Repo change-suggestion (RAG over a LOCAL codebase) --------------------------------
# OFF by default on purpose - a deployed/shared instance should never index a real
# codebase unintentionally. Only turn this on when running locally against a path you
# control. Embedding always goes through a local Ollama model, never a cloud API, even if
# LLM_PROVIDER=anthropic above - see app/services/repo_index.py for why.
REPO_SUGGESTION_ENABLED=false
BACKEND_REPO_PATH=
FRONTEND_REPO_PATH=
REPO_INDEX_DIR=./repo_index
REPO_EMBEDDING_MODEL=nomic-embed-text
REPO_SIMILARITY_THRESHOLD=0.35

# Fields (and whole documents, via doc_type_confidence) below this score are routed
# to the human review queue instead of being marked complete.
REVIEW_CONFIDENCE_THRESHOLD=0.75
