# Copy to .env and fill in.

# Postgres in production (recommended for anything deployed - Render's free-tier local
# disk does NOT survive a spin-down/restart, so SQLite loses all data on the deployed
# instance regularly, not just occasionally. See decisions.md #19.
#
# Neon (neon.tech) free tier is a good fit: pure Postgres, no bundled auth/storage you
# don't need. Copy the connection string from your Neon dashboard - it already includes
# sslmode=require. Example shape:
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/docparser?sslmode=require
#
# For local dev with persistent history across sessions instead of SQLite, a local
# Supabase Postgres also works (`supabase start` -> default local DB URL below). See
# README "Running against a local Supabase Postgres" and decisions.md #20.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
#
# Defaults to a local SQLite file if unset - fine for local dev, not for a deployed instance.
DATABASE_URL=sqlite:///./docparser.db

UPLOAD_DIR=./uploads

# Provider: "anthropic" (default, cloud) or "ollama" (local, free, offline)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key-here
EXTRACTION_MODEL=claude-sonnet-4-6

# Only used when LLM_PROVIDER=ollama. Model must support vision + structured output
# (e.g. llama3.2-vision, qwen2.5vl, minicpm-v). Run `ollama serve` before starting the app.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_MAX_PAGES=5
OLLAMA_TIMEOUT_SECONDS=120

# Only used when LLM_PROVIDER=openrouter. OpenRouter is a cloud aggregator (like Anthropic
# direct) - NOT a local/privacy option. Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-your-key-here
# Free tier: nvidia/nemotron-3-ultra-550b-a55b:free - the first free model actually
# verified end-to-end against this pipeline (PDF file-block + forced tool_choice), not
# just documented elsewhere as capable. A real BSE circular was correctly classified with
# it, including a well-reasoned low-confidence effective_date field that correctly cited
# where the real answer lives instead of guessing.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Fallbacks if that stops working or gets delisted:
# OPENROUTER_MODEL=tencent/hy3:free                    # well-evidenced, not live-tested
# OPENROUTER_MODEL=openrouter/free                     # auto-router, filters by capability
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6         # paid, already confirmed working
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=docparser
OPENROUTER_TIMEOUT_SECONDS=120

# --- Repo change-suggestion (RAG over a LOCAL codebase) --------------------------------
# OFF by default on purpose - a deployed/shared instance should never index a real
# codebase unintentionally. Only turn this on when running locally against a path you
# control. Embedding always goes through a local Ollama model, never a cloud API, even if
# LLM_PROVIDER=anthropic above - see app/services/repo_index.py for why.
REPO_SUGGESTION_ENABLED=false
BACKEND_REPO_PATH=
FRONTEND_REPO_PATH=
REPO_INDEX_DIR=./repo_index
REPO_EMBEDDING_MODEL=nomic-embed-text
REPO_SIMILARITY_THRESHOLD=0.35

# Fields (and whole documents, via doc_type_confidence) below this score are routed
# to the human review queue instead of being marked complete.
REVIEW_CONFIDENCE_THRESHOLD=0.75
